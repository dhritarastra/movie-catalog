# Dates are yyyy-MM-dd strings. Updates replace every field; `version` guards against lost updates.

scalar Upload

type Query {
  movies(page: PageInput): MoviePage!
  movie(id: ID!): Movie
  people(
    page: PageInput
    "Only people whose name contains this text, ignoring case. Omitted or blank lists everyone."
    nameContains: String
  ): PersonPage!
  person(id: ID!): Person
  "Movies and people matching the query, best match first. An explicit null limit means the default of 10."
  search(query: String!, limit: Int = 10): [SearchResult!]!
  "Whether this server can look up posters on TMDB."
  tmdbPostersEnabled: Boolean!
  "The poster TMDB finds for the movie's title and release year, or null if it finds none."
  tmdbPoster(movieId: ID!): TmdbPoster
}

type Mutation {
  createMovie(input: MovieInput!): Movie!
  updateMovie(id: ID!, version: Int!, input: MovieInput!): Movie!
  deleteMovie(id: ID!, version: Int!): ID!
  uploadArtwork(movieId: ID!, version: Int!, file: Upload!): Movie!
  removeArtwork(movieId: ID!, version: Int!): Movie!
  "Attaches a TMDB poster with the same version check as uploadArtwork."
  useTmdbPoster(movieId: ID!, version: Int!, tmdbId: Int!): Movie!

  createPerson(input: PersonInput!): Person!
  updatePerson(id: ID!, version: Int!, input: PersonInput!): Person!
  deletePerson(id: ID!, version: Int!): ID!

  addCredit(input: AddCreditInput!): Credit!
  updateCredit(id: ID!, input: UpdateCreditInput!): Credit!
  removeCredit(id: ID!): ID!
}

type Movie {
  id: ID!
  title: String!
  synopsis: String
  releaseDate: String
  runtimeMinutes: Int
  genres: [String!]!
  "Null when the movie has no artwork; the UI shows a placeholder. Omitting variant means FULL."
  artworkUrl(variant: ArtworkVariant! = FULL): String
  version: Int!
  cast: [Credit!]!
  creators: [Credit!]!
  createdAt: String!
  updatedAt: String!
}

enum ArtworkVariant {
  FULL
  THUMBNAIL
}

type Person {
  id: ID!
  name: String!
  bio: String
  birthDate: String
  version: Int!
  "Every credit for this person, across cast and creator roles."
  credits: [Credit!]!
  createdAt: String!
  updatedAt: String!
}

enum CreditType {
  CAST
  DIRECTOR
  WRITER
  PRODUCER
}

type Credit {
  id: ID!
  type: CreditType!
  "Only set for cast credits."
  characterName: String
  billingOrder: Int!
  "Null only if the movie was deleted while this response was being built."
  movie: Movie
  "Null only if the person was deleted while this response was being built."
  person: Person
}

union SearchResult = Movie | Person

"""
Offset pagination: offset >= 0 and 1 <= limit <= 100. Other values are a BAD_REQUEST error;
they are never silently adjusted, so the next page starts at offset + limit.
An explicit null limit means the default of 20.
"""
input PageInput {
  offset: Int = 0
  limit: Int = 20
}

type MoviePage {
  items: [Movie!]!
  totalCount: Int!
  offset: Int!
  limit: Int!
}

type PersonPage {
  items: [Person!]!
  totalCount: Int!
  offset: Int!
  limit: Int!
}

input MovieInput {
  title: String!
  synopsis: String
  releaseDate: String
  runtimeMinutes: Int
  genres: [String!]!
}

input PersonInput {
  name: String!
  bio: String
  birthDate: String
}

input AddCreditInput {
  movieId: ID!
  personId: ID!
  type: CreditType!
  characterName: String
  billingOrder: Int!
}

input UpdateCreditInput {
  type: CreditType!
  characterName: String
  billingOrder: Int!
}

"A poster found on TMDB (themoviedb.org), shown to the user before they use it."
type TmdbPoster {
  tmdbId: Int!
  title: String!
  releaseYear: String
  previewUrl: String!
}
