# Copy to .env to override the defaults in docker-compose.yml. Local development values only.
WEB_PORT=3000
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
CATALOG_DB_PASSWORD=catalog
MEDIA_DB_PASSWORD=media

# Optional. A TMDB API Read Access Token turns on "Find poster on TMDB" and real posters in the
# seed. Leave it empty to turn both off. Keep the real token in .env only, never in this file.
TMDB_API_TOKEN=
